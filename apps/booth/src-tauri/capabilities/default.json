{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the guest-facing UI. Fault injection and logs are deliberately absent (see dev.json).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-camera-list",
    "allow-camera-select",
    "allow-camera-connect",
    "allow-camera-disconnect",
    "allow-live-view-start",
    "allow-live-view-stop",
    "allow-session-start",
    "allow-session-cancel",
    "allow-session-take-another",
    "allow-session-return-home",
    "allow-session-state",
    "allow-settings-get",
    "allow-settings-set"
  ]
}
