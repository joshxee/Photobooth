// Portal Worker (DESIGN.md §4, §4.1, §5). One Worker serves the guest/device host and the admin
// host. The top level is LOCAL DEVELOPMENT (`wrangler dev`, Vitest): localhost hosts and
// placeholder IDs. `env.staging` and `env.production` are filled in by session 07.
// No account_id, secrets or real IDs here: the repo is public.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Not "portal": that is the production Worker, and a bare `wrangler deploy` (no --env) would
  // overwrite it with this local-development config.
  "name": "portal-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-22",

  // Disabled so the admin Access app can't be bypassed through an alternate hostname (§4).
  "workers_dev": false,
  "preview_urls": false,
  // redact_query_string: Workers Logs would otherwise record each request's full URL, and upload
  // URLs carry their signature in the query (DESIGN §13: logs never include query strings).
  // Inherited by staging and production.
  "observability": { "enabled": true, "redact_query_string": true },

  // run_worker_first: every response, including static assets, goes through the Worker so it
  // gets the security headers and the host check (wiki/Portal.md).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Daily at 14:00 UTC = 03:00 NZDT (summer) / 02:00 NZST (winter): cron has no time zone, so
  // the NZ clock time drifts by an hour with DST. Harmless for a purge job.
  "triggers": { "crons": ["0 14 * * *"] },

  // Bindings and vars are NOT inherited by environments, so each block lists its own.
  "d1_databases": [
    { "binding": "DB", "database_name": "portal-local", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "portal-media-local" }],
  // Rate limits (DESIGN §13). ENROL_LIMITER: 10 enrolment attempts a minute per IP (session 05).
  // INTENT_LIMITER: 120 upload intents a minute per device (session 06). SESSION_LIMITER: 60 gallery
  // token swaps a minute per IP (session 11; a venue's guests share one address). The reasoning for
  // each is in wiki/Portal.md.
  "ratelimits": [
    { "name": "ENROL_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "INTENT_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  // Secrets are set with `wrangler secret put` (staging/production) or `.dev.vars` (local, copied from
  // .dev.vars.example), never here. UPLOAD_KEY signs the upload URLs (lib/uploadUrl.ts), SESSION_KEY
  // the guest cookies (lib/guestCookie.ts).
  "secrets": { "required": ["UPLOAD_KEY", "SESSION_KEY"] },
  "vars": {
    "GALLERY_HOST": "photos.localhost:8787",
    "ADMIN_HOST": "admin.localhost:8787",
    "ADMIN_EMAILS": "",
    "ADMIN_SERVICE_CLIENTS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // The gallery footer's removal contact (DESIGN §11). Local placeholders: the address is the
    // business's published one, the email a reserved .invalid domain. Staging and production set theirs.
    "CONTACT_ADDRESS": "34b Malvern Road, Morningside, Auckland",
    "CONTACT_EMAIL": "privacy@example.invalid",
    // Local development only: `wrangler dev --var DEV_AUTH:1` injects a fixed admin actor, and only
    // on a *.localhost host (middleware/adminAuth.ts). Never set it in staging or production.
    "DEV_AUTH": "",
    // The deployed commit, reported by /healthz. The deploy workflows set it with `--var GIT_SHA:<sha>`.
    "GIT_SHA": ""
  },

  "env": {
    // STAGING, INTERIM (until knockbox.nz is Active in this account; wiki/Portal.md → "Interim
    // staging on workers.dev"): two Workers built from the same code, sharing one D1 and one R2,
    // because a Worker has one workers.dev hostname and the Worker routes on Host.
    //   portal-staging        gallery + device API at portal-staging.josh-33c.workers.dev; no Access
    //                         (booths aren't browsers); its ADMIN_HOST never resolves.
    //   portal-staging-admin  admin UI + API at portal-staging-admin.josh-33c.workers.dev, behind
    //                         Worker-level Cloudflare Access (SETUP D), which covers that hostname.
    // workers_dev is on for these two only; production stays custom-domain-only (§4.1).
    // Deployed only by .github/workflows/deploy-staging.yml.
    "staging": {
      "name": "portal-staging",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        { "binding": "DB", "database_name": "portal-staging", "database_id": "7c271f92-eedd-4364-8843-d8a306629868" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "portal-media-staging" }],
      "ratelimits": [
        { "name": "ENROL_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SESSION_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "INTENT_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } }
      ],
      "secrets": { "required": ["UPLOAD_KEY", "SESSION_KEY"] },
      "vars": {
        "GALLERY_HOST": "portal-staging.josh-33c.workers.dev",
        // Never resolves (.invalid), so this Worker, which has no Access in front, never serves admin.
        // Its Access vars are empty as well: adminAuth would refuse everything even if it did.
        "ADMIN_HOST": "admin.portal-staging.invalid",
        "ADMIN_EMAILS": "",
        "ADMIN_SERVICE_CLIENTS": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "CONTACT_ADDRESS": "34b Malvern Road, Morningside, Auckland",
        "CONTACT_EMAIL": "privacy@knockbox.nz",
        // Always empty here: DEV_AUTH is for `wrangler dev` only (and works only on *.localhost).
        "DEV_AUTH": "",
        // Set by the deploy workflow (`--var GIT_SHA:<sha>`), reported by /healthz.
        "GIT_SHA": ""
      }
    },
    "staging-admin": {
      "name": "portal-staging-admin",
      "workers_dev": true,
      "preview_urls": false,
      // The retention cron runs on portal-staging only, so it never runs twice against the shared D1.
      "triggers": { "crons": [] },
      "d1_databases": [
        { "binding": "DB", "database_name": "portal-staging", "database_id": "7c271f92-eedd-4364-8843-d8a306629868" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "portal-media-staging" }],
      // The same limiters and secrets as portal-staging, so both Workers are the one Worker of the
      // design with different hosts (and typed alike). The admin app uses neither today.
      "ratelimits": [
        { "name": "ENROL_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SESSION_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "INTENT_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } }
      ],
      "secrets": { "required": ["UPLOAD_KEY", "SESSION_KEY"] },
      "vars": {
        // The gallery Worker's hostname, so event QR links point at it. This Worker never receives
        // that Host (workers.dev routes it to portal-staging), and Access covers it whole anyway.
        "GALLERY_HOST": "portal-staging.josh-33c.workers.dev",
        "ADMIN_HOST": "portal-staging-admin.josh-33c.workers.dev",
        "ADMIN_EMAILS": "josh@knockbox.nz,jbxcleland@gmail.com",
        // The `agent-staging` Access service token's client ID (not a secret; staging only).
        "ADMIN_SERVICE_CLIENTS": "95cbf1b7c7795c914e02b7b77543c3a8.access",
        "ACCESS_TEAM_DOMAIN": "knockbox.cloudflareaccess.com",
        // The AUD tag of the Worker-level Access application on portal-staging-admin (SETUP D).
        "ACCESS_AUD": "",
        "CONTACT_ADDRESS": "34b Malvern Road, Morningside, Auckland",
        "CONTACT_EMAIL": "privacy@knockbox.nz",
        "DEV_AUTH": "",
        "GIT_SHA": ""
      }
    },
    "production": {
      "name": "portal",
      "routes": [
        { "pattern": "photos.example.invalid", "custom_domain": true },
        { "pattern": "admin.example.invalid", "custom_domain": true }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "portal", "database_id": "00000000-0000-0000-0000-000000000000" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "portal-media" }],
      "ratelimits": [
        { "name": "ENROL_LIMITER", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SESSION_LIMITER", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
        { "name": "INTENT_LIMITER", "namespace_id": "3003", "simple": { "limit": 120, "period": 60 } }
      ],
      "secrets": { "required": ["UPLOAD_KEY", "SESSION_KEY"] },
      "vars": {
        "GALLERY_HOST": "photos.example.invalid",
        "ADMIN_HOST": "admin.example.invalid",
        "ADMIN_EMAILS": "",
        "ADMIN_SERVICE_CLIENTS": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "CONTACT_ADDRESS": "",
        "CONTACT_EMAIL": "",
        // Always empty here: DEV_AUTH is for `wrangler dev` only (and works only on *.localhost).
        "DEV_AUTH": "",
        "GIT_SHA": ""
      }
    }
  }
}
